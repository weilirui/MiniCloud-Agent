# ============================================================
# minicloud-agent 环境变量模板
# 用法： cp .env.example .env  然后至少填写 OPENAI_API_KEY
# ============================================================

# ----- LLM（任何 OpenAI 兼容端点：OpenAI / DeepSeek / Qwen / Moonshot）-----
OPENAI_API_KEY=sk-xxx
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# ----- Embedding（可与 LLM 使用不同端点）-----
# 留空则复用 OPENAI_API_KEY / OPENAI_BASE_URL
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=text-embedding-3-small
# 必须与所选 embedding 模型的输出维度一致，否则 Qdrant 写入会失败
EMBEDDING_DIM=1536

# ----- PostgreSQL -----
# Docker Compose 内部用 postgres；从宿主机直连改成 localhost
POSTGRES_USER=minicloud
POSTGRES_PASSWORD=minicloud
POSTGRES_DB=minicloud
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ----- Qdrant -----
# Compose 内部 http://qdrant:6333；宿主机是 http://localhost:16333
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=minicloud_kb

# ----- Skills -----
SKILLS_BUILTIN_DIR=/app/app/skills/builtin
SKILLS_USER_DIR=/app/data/skills

# ----- MCP -----
MCP_SERVERS_FILE=/app/mcp.servers.json

# ----- 应用 -----
APP_PORT=8000
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ----- 上下文预算 -----
MAX_CONTEXT_TOKENS=8000
MAX_AGENT_ITERATIONS=10
SUMMARY_MODEL=gpt-4o-mini
